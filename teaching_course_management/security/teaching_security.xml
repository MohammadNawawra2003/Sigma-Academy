<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_groups_privilege_teaching" model="res.groups.privilege">
        <field name="name">Teaching</field>
        <field name="sequence">30</field>
        <field name="category_id" ref="base.module_category_services"/>
    </record>

    <record id="group_teaching_instructor" model="res.groups">
        <field name="name">Instructor</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_teaching"/>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user')),
                                         Command.link(ref('account.group_account_invoice')),
                                         Command.link(ref('appointment.group_appointment_user'))]"/>
        <field name="comment">Sessions, students, courses, invoices, payments and own availability.</field>
    </record>

    <record id="group_teaching_admin" model="res.groups">
        <field name="name">Administrator</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_teaching"/>
        <field name="implied_ids" eval="[Command.link(ref('group_teaching_instructor')),
                                         Command.link(ref('appointment.group_appointment_manager')),
                                         Command.link(ref('website.group_website_designer'))]"/>
        <field name="user_ids" eval="[Command.link(ref('base.user_root')), Command.link(ref('base.user_admin'))]"/>
        <field name="comment">Everything, plus Configuration, Announcements, Income and Settings.</field>
    </record>
</odoo>
