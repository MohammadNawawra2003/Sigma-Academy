<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_groups_privilege_teaching" model="res.groups.privilege">
        <field name="name">Teaching</field>
        <field name="sequence">30</field>
        <field name="category_id" ref="base.module_category_services"/>
    </record>

    <record id="group_teaching_instructor" model="res.groups">
        <field name="name">Instructor</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_teaching"/>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user')),
                                         Command.link(ref('account.group_account_invoice')),
                                         Command.link(ref('appointment.group_appointment_user'))]"/>
        <field name="comment">Sessions, students, courses, invoices, payments and own availability.</field>
    </record>

    <record id="group_teaching_admin" model="res.groups">
        <field name="name">Administrator</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_teaching"/>
        <field name="implied_ids" eval="[Command.link(ref('group_teaching_instructor')),
                                         Command.link(ref('appointment.group_appointment_manager')),
                                         Command.link(ref('website.group_website_designer'))]"/>
        <field name="user_ids" eval="[Command.link(ref('base.user_root')), Command.link(ref('base.user_admin'))]"/>
        <field name="comment">Everything, plus Configuration, Announcements, Income and Settings.</field>
    </record>

    <!-- Sari 10 Oct (links to wrong pages): natively an internal user reads only published types or
         types he is staff on, so opening a Live Course session raised an Access Error for every other
         instructor. Read only; writing stays with the native own-type rules. Ored with them. -->
    <record id="appointment_type_rule_teaching_instructor_read" model="ir.rule">
        <field name="name">appointment.type: teaching instructor reads every session type</field>
        <field name="model_id" ref="appointment.model_appointment_type"/>
        <field name="domain_force">[('teaching_product_id', '!=', False)]</field>
        <field name="groups" eval="[Command.link(ref('group_teaching_instructor'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Sari 10 Oct: an instructor edits the published slots of every session type he teaches on,
         not only of types he created himself (the native appointment-user rule). Ored with it. -->
    <record id="appointment_slot_rule_teaching_instructor" model="ir.rule">
        <field name="name">appointment.slot: teaching instructor edits slots of own session types</field>
        <field name="model_id" ref="appointment.model_appointment_slot"/>
        <field name="domain_force">[('appointment_type_id.teaching_product_id', '!=', False), ('appointment_type_id.staff_user_ids', 'in', user.id)]</field>
        <field name="groups" eval="[Command.link(ref('group_teaching_instructor'))]"/>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="True"/>
    </record>
</odoo>
