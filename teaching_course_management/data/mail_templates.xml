<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="mail_template_session_confirmed" model="mail.template">
            <field name="name">Teaching: Session confirmed</field>
            <field name="model_id" ref="calendar.model_calendar_event"/>
            <field name="subject">Confirmed: {{ object._teaching_title() }}</field>
            <field name="auto_delete" eval="False"/>
            <field name="body_html" type="html">
<div>
    <p>Hello,</p>
    <p>Your session is <strong>confirmed</strong>.</p>
    <ul>
        <li>Session: <t t-out="object.subject_id.name or ''"/> <t t-out="object.appointment_type_id.name or ''"/></li>
        <li>Students: <t t-out="', '.join(object._teaching_family_view(ctx.get('teaching_family_id')).mapped('name'))"/></li>
        <li>When: <t t-out="object.display_time or ''"/></li>
        <li t-if="object.teaching_mode == 'online' and object.videocall_location">Meeting link: <a t-att-href="object.videocall_location" t-out="object.videocall_location"/></li>
        <li t-if="object.teaching_mode == 'onsite'">On-site session.</li>
    </ul>
    <p>Free cancellation until midnight the night before. After that the session is charged.</p>
    <p>Sigma Academy</p>
</div>
            </field>
        </record>

        <record id="mail_template_session_rejected" model="mail.template">
            <field name="name">Teaching: Booking rejected</field>
            <field name="model_id" ref="calendar.model_calendar_event"/>
            <field name="subject">Booking not accepted: {{ object._teaching_title() }}</field>
            <field name="auto_delete" eval="False"/>
            <field name="body_html" type="html">
<div>
    <p>Hello,</p>
    <p>Your booking request for <t t-out="object.display_time or ''"/> could not be accepted.</p>
    <p t-if="ctx.get('teaching_reject_reason')"><strong>Reason:</strong> <t t-out="ctx.get('teaching_reject_reason')"/></p>
    <p>Please pick another slot on the booking page.</p>
    <p>Sigma Academy</p>
</div>
            </field>
        </record>
        <!-- Shared session (several families): sent instead of Odoo's attendee emails, which list every
             attendee. Names only the family's own children. -->
        <record id="mail_template_shared_session_notice" model="mail.template">
            <field name="name">Teaching: Shared session notice</field>
            <field name="model_id" ref="calendar.model_calendar_attendee"/>
            <field name="subject">{{ object._teaching_notice_heading() }}: {{ object.event_id._teaching_title() }}</field>
            <field name="email_from">{{ (object.event_id.user_id.email_formatted or user.email_formatted or '') }}</field>
            <field name="email_to">{{ object.email }}</field>
            <field name="lang">{{ object.partner_id.lang }}</field>
            <field name="auto_delete" eval="True"/>
            <field name="body_html" type="html">
<div>
    <p>Hello <t t-out="object.common_name or ''"/>,</p>
    <p><strong t-out="object._teaching_notice_heading()"/>.</p>
    <ul>
        <li>Session: <t t-out="object.event_id._teaching_title()"/></li>
        <li>Students: <t t-out="', '.join(object.event_id._teaching_family_view((object.partner_id.parent_id or object.partner_id).id).mapped('name'))"/></li>
        <li>When: <t t-out="object.event_id.display_time or ''"/></li>
        <li>Instructor: <t t-out="object.event_id.user_id.name or ''"/></li>
        <li t-if="object.event_id.teaching_mode == 'onsite'">On-site session.</li>
        <li t-if="ctx.get('teaching_notice') != 'cancel' and object.event_id.appointment_status == 'booked' and object.event_id.teaching_mode == 'online' and object.event_id.videocall_location">Meeting link: <a t-att-href="object.event_id.videocall_location" t-out="object.event_id.videocall_location"/></li>
    </ul>
    <p><a t-attf-href="{{ object.get_base_url() }}/my/sessions/{{ object.event_id.id }}">Open My Sessions</a></p>
    <p>Sigma Academy</p>
</div>
            </field>
        </record>
    </data>
</odoo>
