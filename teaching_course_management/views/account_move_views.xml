<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="account_move_view_form_teaching" model="ir.ui.view">
        <field name="name">account.move.form.teaching</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="teaching_student_id" invisible="not teaching_student_id" readonly="1"/>
            </xpath>
        </field>
    </record>

    <record id="account_move_view_pivot_income" model="ir.ui.view">
        <field name="name">account.move.pivot.income</field>
        <field name="model">account.move</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <pivot string="Income">
                <field name="invoice_date" interval="month" type="row"/>
                <field name="amount_total_signed" string="Invoiced" type="measure"/>
                <field name="teaching_amount_received" string="Received" type="measure"/>
                <field name="amount_residual_signed" string="Outstanding" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="account_move_view_graph_income" model="ir.ui.view">
        <field name="name">account.move.graph.income</field>
        <field name="model">account.move</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <graph string="Income" type="bar" stacked="1">
                <field name="invoice_date" interval="month"/>
                <field name="teaching_amount_received" string="Received" type="measure"/>
                <field name="amount_residual_signed" string="Outstanding" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="account_move_view_list_income" model="ir.ui.view">
        <field name="name">account.move.list.income</field>
        <field name="model">account.move</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <list string="Income" create="0">
                <field name="name"/>
                <field name="invoice_date"/>
                <field name="partner_id"/>
                <field name="teaching_student_id"/>
                <field name="teaching_school_id"/>
                <field name="company_currency_id" column_invisible="1"/>
                <field name="amount_total_signed" string="Invoiced" sum="Total"/>
                <field name="teaching_amount_received" string="Received" sum="Total"/>
                <field name="amount_residual_signed" string="Outstanding" sum="Total"/>
                <field name="payment_state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="account_move_view_search_income" model="ir.ui.view">
        <field name="name">account.move.search.income</field>
        <field name="model">account.move</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <search string="Income">
                <field name="partner_id"/>
                <field name="teaching_student_id"/>
                <field name="teaching_school_id"/>
                <filter name="paid" string="Paid" domain="[('payment_state', 'in', ('paid', 'in_payment'))]"/>
                <filter name="partial" string="Partially Paid" domain="[('payment_state', '=', 'partial')]"/>
                <filter name="not_paid" string="Not Paid" domain="[('payment_state', '=', 'not_paid')]"/>
                <separator/>
                <filter name="outstanding" string="Outstanding" domain="[('amount_residual_signed', '!=', 0)]"/>
                <filter name="invoice_date" string="Invoice Date" date="invoice_date"/>
                <group name="groupby">
                    <filter name="group_month" string="Month" context="{'group_by': 'invoice_date:month'}"/>
                    <filter name="group_student" string="Student" context="{'group_by': 'teaching_student_id'}"/>
                    <filter name="group_school" string="School" context="{'group_by': 'teaching_school_id'}"/>
                    <filter name="group_partner" string="Billed To" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_payment_state" string="Payment Status" context="{'group_by': 'payment_state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_teaching_income" model="ir.actions.act_window">
        <field name="name">Income</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">pivot,graph,list,form</field>
        <field name="domain">[('move_type', 'in', ('out_invoice', 'out_refund')), ('state', '=', 'posted')]</field>
        <field name="context">{'create': False}</field>
        <field name="search_view_id" ref="account_move_view_search_income"/>
        <field name="view_ids" eval="[Command.clear(),
            Command.create({'view_mode': 'pivot', 'view_id': ref('account_move_view_pivot_income')}),
            Command.create({'view_mode': 'graph', 'view_id': ref('account_move_view_graph_income')}),
            Command.create({'view_mode': 'list', 'view_id': ref('account_move_view_list_income')})]"/>
        <field name="help" type="html"><p class="o_view_nocontent_smiling_face">No posted invoices yet</p><p>Invoiced is everything billed. Received counts only registered payments. Outstanding is still owed and is not income.</p></field>
    </record>

    <record id="action_teaching_outstanding" model="ir.actions.act_window">
        <field name="name">Outstanding</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,pivot,form</field>
        <field name="domain">[('move_type', 'in', ('out_invoice', 'out_refund')), ('state', '=', 'posted'), ('payment_state', 'in', ('not_paid', 'partial'))]</field>
        <field name="context">{'create': False, 'search_default_group_partner': 1}</field>
        <field name="search_view_id" ref="account_move_view_search_income"/>
        <field name="view_ids" eval="[Command.clear(),
            Command.create({'view_mode': 'list', 'view_id': ref('account_move_view_list_income')}),
            Command.create({'view_mode': 'pivot', 'view_id': ref('account_move_view_pivot_income')})]"/>
        <field name="help" type="html"><p class="o_view_nocontent_smiling_face">Nothing outstanding</p><p>Every posted invoice is paid.</p></field>
    </record>
</odoo>
