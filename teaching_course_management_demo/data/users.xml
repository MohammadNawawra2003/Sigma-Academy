<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="resource_calendar_sari" model="resource.calendar">
            <field name="name">Sari Ballout — teaching hours</field>
            <field name="tz">Asia/Hebron</field>
            <field name="attendance_ids" eval="[Command.clear(),
                Command.create({'name': 'Mon', 'dayofweek': '0', 'hour_from': 17, 'hour_to': 22, 'day_period': 'afternoon'}),
                Command.create({'name': 'Tue', 'dayofweek': '1', 'hour_from': 16, 'hour_to': 22, 'day_period': 'afternoon'}),
                Command.create({'name': 'Wed', 'dayofweek': '2', 'hour_from': 17, 'hour_to': 22, 'day_period': 'afternoon'}),
                Command.create({'name': 'Thu', 'dayofweek': '3', 'hour_from': 17, 'hour_to': 22, 'day_period': 'afternoon'}),
                Command.create({'name': 'Fri AM', 'dayofweek': '4', 'hour_from': 8, 'hour_to': 12, 'day_period': 'morning'}),
                Command.create({'name': 'Fri PM', 'dayofweek': '4', 'hour_from': 15, 'hour_to': 22, 'day_period': 'afternoon'}),
                Command.create({'name': 'Sat', 'dayofweek': '5', 'hour_from': 17, 'hour_to': 22, 'day_period': 'afternoon'})]"/>
        </record>

        <record id="user_sari" model="res.users">
            <field name="name">Sari Ballout</field>
            <field name="login">sari</field>
            <field name="password">demo</field>
            <field name="email">sari.demo@example.com</field>
            <field name="tz">Asia/Hebron</field>
            <field name="group_ids" eval="[Command.link(ref('teaching_course_management.group_teaching_admin')),
                                           Command.link(ref('account.group_account_manager'))]"/>
        </record>

        <record id="employee_sari" model="hr.employee">
            <field name="name">Sari Ballout</field>
            <field name="user_id" ref="user_sari"/>
            <field name="resource_calendar_id" ref="resource_calendar_sari"/>
            <field name="job_title">Instructor — Physics &amp; Maths</field>
        </record>

        <!-- Sari is the staff on every session type -->
        <record id="teaching_course_management.appointment_type_one_to_one" model="appointment.type">
            <field name="staff_user_ids" eval="[Command.set([ref('user_sari')])]"/>
        </record>
        <record id="teaching_course_management.appointment_type_group" model="appointment.type">
            <field name="staff_user_ids" eval="[Command.set([ref('user_sari')])]"/>
        </record>
        <record id="teaching_course_management.appointment_type_review" model="appointment.type">
            <field name="staff_user_ids" eval="[Command.set([ref('user_sari')])]"/>
        </record>
        <record id="teaching_course_management.appointment_type_course" model="appointment.type">
            <field name="staff_user_ids" eval="[Command.set([ref('user_sari')])]"/>
        </record>
    </data>
</odoo>
